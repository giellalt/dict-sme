datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

# Batches of entries, for assigning work to people.
# An entry is put in a batch with <e batch="...">, see dict-sme.rnc.

start = batches

batches = element batches {
    attribute id {"dict-sme"},
    people,
    batch*
}

# The people who work on the dictionary.
people = element people {
    element person { text }+
}
person = text

# id: what <e batch="..."> refers to; the year (two digits) followed by a
#     number: 2601, 2602, ...
# editor: who writes the entries and makes the corrections
# step: the history of the batch, one step for each time it moved on, in
#     order. The last step is the state the batch is in now.
batch = element batch {
    attribute id { xsd:string { pattern = "[0-9]{4}" } },
    attribute editor { person },
    step+
}

# state: the step the batch moved to, in this order:
#     edit, proofread-1, correcting-1, proofread-2, correcting-2, publish.
# by: who does the step (missing while nobody has it yet)
# date: when the batch moved to the step
step = element step {
    attribute state { state },
    attribute by { person }?,
    attribute date { xsd:date },
    empty
}

state = "edit" | "proofread-1" | "correcting-1" | "proofread-2" | "correcting-2" | "publish"
